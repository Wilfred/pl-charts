        "content-type": "application/json; charset=UTF-8"
      },
      "query": "SELECT tag,toYear(a.CreationDate) AS year,toQuarter(a.CreationDate) AS quarter,count() AS count FROM stackoverflow.posts a INNER JOIN (SELECT Id,arrayFilter(tag -> tag IN ('python','java','go','javascript','c++','typescript','php','ruby','c','c#','nix','bash','rust','scala','kotlin','swift','dart','groovy','perl','lua'),splitByChar('|',Tags)) AS langs FROM stackoverflow.posts WHERE PostTypeId='Question' AND notEmpty(langs)) q ON toInt32OrZero(a.ParentId)=q.Id ARRAY JOIN q.langs AS tag WHERE a.PostTypeId='Answer' AND toYear(a.CreationDate) BETWEEN 2008 AND 2026 GROUP BY tag,year,quarter ORDER BY year,quarter,tag SETTINGS max_execution_time=60,max_memory_usage=28000000000 FORMAT JSON"
