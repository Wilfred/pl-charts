      "query": "SELECT arrayJoin(arrayFilter(tag -> tag IN ('python','java','go','javascript','c++','typescript','php','ruby','c','c#','nix','bash','rust','scala','kotlin','swift','dart','groovy','perl','lua'),splitByChar('|',Tags))) AS tag,toYear(CreationDate) AS year,toQuarter(CreationDate) AS quarter,count() AS count FROM stackoverflow.posts WHERE PostTypeId='Question' AND toYear(CreationDate) BETWEEN 2008 AND 2026 GROUP BY tag,year,quarter ORDER BY year,quarter,tag SETTINGS max_execution_time=60 FORMAT JSON"
