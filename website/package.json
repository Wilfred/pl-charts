{
  "name": "@pl-charts/website",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run import:packages && vite --host 0.0.0.0 --port 8000 --strictPort",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 8000 --strictPort",
    "typecheck": "npm run import:packages && tsc --noEmit",
    "test": "npm run import:packages && tsx --test tests/*.test.ts",
    "import:packages": "tsx scripts/import-packages.ts"
  },
  "devDependencies": {
    "vite": "8.3.5",
    "jsdom": "30.1.3",
    "@types/jsdom": "30.0.0",
    "typescript": "6.0.3",
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "csv-parse": "7.0.3"
  }
}
