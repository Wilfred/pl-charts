{
  "name": "@pl-charts/website",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 8000 --strictPort",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 8000 --strictPort",
    "typecheck": "npm run render && tsc --noEmit",
    "test": "npm run render && tsx --test tests/*.test.ts",
    "render": "tsx scripts/render.tsx"
  },
  "devDependencies": {
    "@types/jsdom": "30.0.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "csv-parse": "7.0.3",
    "jsdom": "30.1.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
