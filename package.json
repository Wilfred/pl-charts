{
  "name": "pl-charts",
  "private": true,
  "scripts": {
    "dev": "npm run dev --workspace website",
    "build": "npm run build --workspace website",
    "preview": "npm run preview --workspace website",
    "typecheck": "tsc --noEmit && npm run typecheck --workspaces --if-present",
    "test": "node --test tests/*.test.ts && npm run test --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "git config core.hooksPath .githooks",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "collect:packages": "npm run collect:packages --workspace collectors",
    "collect:github": "npm run collect:github --workspace collectors --"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "jiti": "2.7.0",
    "prettier": "3.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "workspaces": [
    "website",
    "collectors"
  ]
}
