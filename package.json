{
  "name": "pl-charts",
  "private": true,
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 8000 --strictPort",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 8000 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "git config core.hooksPath .githooks",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/jsdom": "30.0.0",
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "jiti": "2.7.0",
    "jsdom": "30.1.3",
    "prettier": "3.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  }
}
