{
  "name": "pl-charts",
  "private": true,
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 8000 --strictPort",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 8000 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@types/jsdom": "30.0.0",
    "@types/node": "22.20.5",
    "jsdom": "30.1.3",
    "prettier": "3.8.1",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  }
}
